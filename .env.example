# Local development defaults only. Replace every password/secret before any shared or public deployment.
MYSQL_ROOT_PASSWORD=change_me_locally
MYSQL_DATABASE=airline
MYSQL_USER=airline
MYSQL_PASSWORD=change_me_locally
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_POOL_SIZE=10
DATABASE_URL=mysql://airline:change_me_locally@mysql:3306/airline
REDIS_URL=redis://redis:6379
JWT_SECRET=replace_with_random_secret_at_least_32_chars
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
LOG_LEVEL=info
AI_SERVICE_URL=http://ai-service:8000
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Local mail is captured by MailHog; no external email credentials are required.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=skymate@localhost.test
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Demo accounts and provider selection (safe local defaults)
DEMO_ADMIN_PASSWORD=change_me_locally
PAYMENT_PROVIDER=mock
CURRENCY_PROVIDER=frankfurter
WEATHER_PROVIDER=open-meteo
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SENTRY_DSN=
PAYMENT_WEBHOOK_SECRET=replace_with_a_separate_random_webhook_secret

# Airline / flight search
AIRLINE_PROVIDER=mock
DUFFEL_ACCESS_TOKEN=
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Payment: mock works offline; stripe/razorpay require sandbox credentials.
FRONTEND_PUBLIC_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio SMS and WhatsApp sandbox (optional).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=mock
TWILIO_WHATSAPP_FROM=mock
